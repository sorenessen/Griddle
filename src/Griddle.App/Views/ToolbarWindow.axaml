<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Griddle.App.ViewModels"
    x:Class="Griddle.App.Views.ToolbarWindow"
    x:DataType="vm:ToolbarViewModel"
    Width="1000"
    Height="55"
    CanResize="False"
    WindowDecorations="None"
    Topmost="True">

    <Window.Styles>

        <Style Selector="Button.toolbar">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>

            <!-- much darker control face -->
            <Setter Property="Background" Value="#17191B"/>

            <!-- exposed steel edge -->
            <Setter Property="BorderBrush" Value="#73787D"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#292C2F"/>
            <Setter Property="BorderBrush" Value="#B4BBC0"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="Button.toolbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0D0E0F"/>
            <Setter Property="BorderBrush" Value="#F28C28"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="Button.toolbar.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#201C18"/>
            <Setter Property="BorderBrush" Value="#F28C28"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="Button.color-swatch">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#25282B"/>
            <Setter Property="BorderBrush" Value="#50555A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.color-swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#35393D"/>
            <Setter Property="BorderBrush" Value="#F28C28"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

    </Window.Styles>

    <Border
        CornerRadius="12"
        BorderBrush="#8E9296"
        BorderThickness="1"
        Padding="10"
        PointerPressed="ToolbarBackground_PointerPressed">

        <Border.Background>
            <ImageBrush
                Source="avares://Griddle.App/Assets/griddle-shock-blue-tile.png"
                Stretch="UniformToFill"
                AlignmentX="Center"
                AlignmentY="Center"/>
        </Border.Background>

        <StackPanel
            Orientation="Horizontal"
            Spacing="8">

            <Button
                Classes="griddle-knob"
                Click="GriddleKnob_Click"
                Padding="0"
                Margin="0,-10,0,-10"
                Background="Transparent"
                BorderThickness="0">

                <Button.Template>
                    <ControlTemplate>
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            Background="Transparent"/>
                    </ControlTemplate>
                </Button.Template>

                <Grid
                    Width="82"
                    Height="108"
                    Margin="0,0,-8,0">

                    <Image
                        Source="avares://Griddle.App/Assets/griddle-toolbar-on-orange.png"
                        Width="82"
                        Height="82"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsOverlayEngaged}"/>

                    <Image
                        Source="avares://Griddle.App/Assets/griddle-toolbar-off.png"
                        Width="82"
                        Height="82"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsOverlayDisengaged}"/>

                </Grid>

            </Button>

            <Border
                Width="1"
                Height="30"
                Background="#5A5A5A"
                Margin="0,0,4,0"/>

            <Button
                Classes="toolbar"
                Classes.active="{Binding IsSelectionSelected}"
                Click="SelectionButton_Click"
                ToolTip.Tip="Select">

                <Grid Width="22" Height="22">
                    <Path
                        Stroke="White"
                        StrokeThickness="2"
                        Data="M4,3 L17,12 L11,13 L14,19 L11,20 L8,14 L4,18 Z"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                Classes.active="{Binding IsPenSelected}"
                Click="PenButton_Click"
                ToolTip.Tip="Pen">

                <Grid Width="22" Height="22">
                    <Line
                        StartPoint="5,17"
                        EndPoint="16,6"
                        Stroke="White"
                        StrokeThickness="3"
                        StrokeLineCap="Round"/>

                    <Ellipse
                        Width="5"
                        Height="5"
                        Fill="White"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,2,2,0"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                Classes.active="{Binding IsArrowSelected}"
                Click="ArrowButton_Click"
                ToolTip.Tip="Arrow">

                <Grid Width="22" Height="22">
                    <Line
                        StartPoint="4,18"
                        EndPoint="17,5"
                        Stroke="White"
                        StrokeThickness="3"
                        StrokeLineCap="Round"/>

                    <Line
                        StartPoint="11,5"
                        EndPoint="17,5"
                        Stroke="White"
                        StrokeThickness="3"
                        StrokeLineCap="Round"/>

                    <Line
                        StartPoint="17,5"
                        EndPoint="17,11"
                        Stroke="White"
                        StrokeThickness="3"
                        StrokeLineCap="Round"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                Classes.active="{Binding IsRectangleSelected}"
                Click="RectangleButton_Click"
                ToolTip.Tip="Rectangle">

                <Grid Width="22" Height="22">
                    <Rectangle
                        Width="14"
                        Height="12"
                        Stroke="White"
                        StrokeThickness="2"
                        Fill="Transparent"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                Classes.active="{Binding IsTextSelected}"
                Click="TextButton_Click"
                ToolTip.Tip="Text">

                <Grid Width="22" Height="22">
                    <TextBlock
                        Text="T"
                        Foreground="White"
                        FontSize="18"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                Classes.active="{Binding IsCalloutSelected}"
                Click="CalloutButton_Click"
                ToolTip.Tip="Callout">

                <Grid Width="22" Height="22">
                    <Ellipse
                        Width="16"
                        Height="16"
                        Stroke="White"
                        StrokeThickness="2"/>

                    <TextBlock
                        Text="1"
                        Foreground="White"
                        FontSize="10"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                Click="NewCalloutGroupButton_Click"
                ToolTip.Tip="Start new callout sequence">

                <Grid Width="22" Height="22">
                    <Ellipse
                        Width="16"
                        Height="16"
                        Stroke="White"
                        StrokeThickness="2"/>

                    <TextBlock
                        Text="1↺"
                        Foreground="White"
                        FontSize="8"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                Click="SelectCalloutGroupButton_Click"
                ToolTip.Tip="Select callout sequence">

                <Grid Width="22" Height="22">
                    <Ellipse
                        Width="14"
                        Height="14"
                        Stroke="White"
                        StrokeThickness="1.5"
                        HorizontalAlignment="Left"/>

                    <Ellipse
                        Width="14"
                        Height="14"
                        Stroke="White"
                        StrokeThickness="1.5"
                        HorizontalAlignment="Right"/>

                    <TextBlock
                        Text="•••"
                        Foreground="White"
                        FontSize="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                Click="HideCalloutGroupButton_Click"
                ToolTip.Tip="Hide selected callout sequence">

                <Grid Width="22" Height="22">
                    <TextBlock
                        Text="◉"
                        Foreground="White"
                        FontSize="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    <Line
                        StartPoint="4,18"
                        EndPoint="18,4"
                        Stroke="White"
                        StrokeThickness="2"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                Click="ShowLastHiddenCalloutGroupButton_Click"
                ToolTip.Tip="Show last hidden callout sequence">

                <Grid Width="22" Height="22">
                    <TextBlock
                        Text="◉"
                        Foreground="White"
                        FontSize="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                Classes.active="{Binding IsCalloutPresentationActive}"
                Click="StartCalloutPresentationButton_Click"
                ToolTip.Tip="Present selected callout sequence">

                <Grid Width="22" Height="22">

                    <Path
                        Fill="White"
                        Data="M7,4 L18,11 L7,18 Z"/>

                </Grid>

            </Button>

            <Border
                IsVisible="{Binding IsCalloutPresentationActive}"
                Height="40"
                MinWidth="52"
                Padding="8,0"
                CornerRadius="8"
                Background="#333333"
                BorderBrush="#F28C28"
                BorderThickness="1">

                <TextBlock
                    Text="{Binding PresentationProgressText}"
                    Foreground="White"
                    FontSize="13"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

            </Border>

            <Button
                Classes="toolbar"
                Click="ContinueCalloutGroupButton_Click"
                ToolTip.Tip="Continue selected callout sequence">

                <Grid Width="22" Height="22">
                    <Ellipse
                        Width="16"
                        Height="16"
                        Stroke="White"
                        StrokeThickness="2"/>

                    <TextBlock
                        Text="↺"
                        Foreground="White"
                        FontSize="12"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                Click="RenumberCalloutGroupButton_Click"
                ToolTip.Tip="Compact selected callout sequence">

                <Grid Width="22" Height="22">
                    <TextBlock
                        Text="123"
                        Foreground="White"
                        FontSize="9"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                ToolTip.Tip="Annotation color">

                <Grid Width="22" Height="22">

                    <Ellipse
                        Width="16"
                        Height="16"
                        Fill="{Binding SelectedColorBrush}"
                        Stroke="White"
                        StrokeThickness="1"/>

                </Grid>

                <Button.Flyout>
                    <Flyout Placement="Bottom">

                        <Border
                            Background="#1B1D1F"
                            BorderBrush="#73787D"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8">

                            <Grid
                                ColumnDefinitions="Auto,Auto,Auto,Auto"
                                RowDefinitions="Auto,Auto"
                                ColumnSpacing="6"
                                RowSpacing="6">

                                <Button
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Classes="color-swatch"
                                    Click="RedColorButton_Click"
                                    ToolTip.Tip="Red">
                                    <Ellipse Fill="Red"/>
                                </Button>

                                <Button
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Classes="color-swatch"
                                    Click="OrangeColorButton_Click"
                                    ToolTip.Tip="Orange">
                                    <Ellipse Fill="Orange"/>
                                </Button>

                                <Button
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Classes="color-swatch"
                                    Click="YellowColorButton_Click"
                                    ToolTip.Tip="Yellow">
                                    <Ellipse Fill="Yellow"/>
                                </Button>

                                <Button
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    Classes="color-swatch"
                                    Click="GreenColorButton_Click"
                                    ToolTip.Tip="Green">
                                    <Ellipse Fill="LimeGreen"/>
                                </Button>

                                <Button
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Classes="color-swatch"
                                    Click="BlueColorButton_Click"
                                    ToolTip.Tip="Blue">
                                    <Ellipse Fill="DodgerBlue"/>
                                </Button>

                                <Button
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Classes="color-swatch"
                                    Click="PurpleColorButton_Click"
                                    ToolTip.Tip="Purple">
                                    <Ellipse Fill="MediumPurple"/>
                                </Button>

                                <Button
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Classes="color-swatch"
                                    Click="WhiteColorButton_Click"
                                    ToolTip.Tip="White">
                                    <Ellipse
                                        Fill="White"
                                        Stroke="#777777"
                                        StrokeThickness="1"/>
                                </Button>

                                <Button
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    Classes="color-swatch"
                                    Click="BlackColorButton_Click"
                                    ToolTip.Tip="Black">
                                    <Ellipse
                                        Fill="Black"
                                        Stroke="White"
                                        StrokeThickness="1"/>
                                </Button>

                            </Grid>

                        </Border>

                    </Flyout>
                </Button.Flyout>

            </Button>

            <Button
                Classes="toolbar"
                Classes.active="{Binding IsHighlighterSelected}"
                Click="HighlighterButton_Click"
                ToolTip.Tip="Highlighter">

                <Grid Width="22" Height="22">
                    <Rectangle
                        Width="8"
                        Height="16"
                        Fill="#FFF3C400"
                        RadiusX="2"
                        RadiusY="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">

                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="-35"/>
                        </Rectangle.RenderTransform>

                    </Rectangle>

                    <Rectangle
                        Width="14"
                        Height="3"
                        Fill="#FFF3C400"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,1"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                ToolTip.Tip="Thickness">

                <Grid Width="22" Height="22">
                    <Line
                        StartPoint="3,7"
                        EndPoint="19,7"
                        Stroke="White"
                        StrokeThickness="2"
                        StrokeLineCap="Round"/>

                    <Line
                        StartPoint="3,15"
                        EndPoint="19,15"
                        Stroke="White"
                        StrokeThickness="5"
                        StrokeLineCap="Round"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                Classes.active="{Binding IsTintEnabled}"
                Click="TintButton_Click"
                ToolTip.Tip="Toggle overlay tint">

                <Grid Width="22" Height="22">

                    <Border
                        Width="16"
                        Height="13"
                        BorderBrush="White"
                        BorderThickness="2"
                        Background="Transparent"
                        CornerRadius="2"/>

                    <Rectangle
                        Width="8"
                        Height="9"
                        Fill="#66FF8C00"
                        HorizontalAlignment="Left"
                        Margin="4,0,0,0"/>

                </Grid>

            </Button>

        </StackPanel>

    </Border>

</Window>