<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Griddle.App.ViewModels"
    x:Class="Griddle.App.Views.ToolbarWindow"
    x:DataType="vm:ToolbarViewModel"
    Height="55"
    SizeToContent="Width"
    CanResize="False"    WindowDecorations="None"
    Topmost="True">

    <Window.Styles>

        <Style Selector="Button.toolbar">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>

            <!-- much darker control face -->
            <Setter Property="Background" Value="#17191B"/>

            <!-- exposed steel edge -->
            <Setter Property="BorderBrush" Value="#73787D"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#292C2F"/>
            <Setter Property="BorderBrush" Value="#B4BBC0"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="Button.toolbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0D0E0F"/>
            <Setter Property="BorderBrush" Value="#F28C28"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="Button.toolbar.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#201C18"/>
            <Setter Property="BorderBrush" Value="#F28C28"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="Button.color-swatch">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#25282B"/>
            <Setter Property="BorderBrush" Value="#50555A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.color-swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#35393D"/>
            <Setter Property="BorderBrush" Value="#F28C28"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="Button.color-swatch.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#35393D"/>
            <Setter Property="BorderBrush" Value="#F28C28"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="Button.thickness-swatch">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#25282B"/>
            <Setter Property="BorderBrush" Value="#50555A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.thickness-swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#35393D"/>
            <Setter Property="BorderBrush" Value="#F28C28"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="Button.display-option">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.display-option:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#35393D"/>
        </Style>

        <Style Selector="Image.recording-knob">
            <Style.Animations>
                <Animation
                    Duration="0:0:1"
                    IterationCount="INFINITE"
                    PlaybackDirection="Alternate"
                    Easing="SineEaseInOut">

                    <KeyFrame Cue="0%">
                        <Setter
                            Property="Opacity"
                            Value="1"/>
                    </KeyFrame>

                    <KeyFrame Cue="100%">
                        <Setter
                            Property="Opacity"
                            Value="0.25"/>
                    </KeyFrame>

                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="CheckBox.recording-option">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="CheckBox.recording-option /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>

    </Window.Styles>

    <Border
        CornerRadius="12"
        BorderBrush="#8E9296"
        BorderThickness="1"
        Padding="10"
        PointerPressed="ToolbarBackground_PointerPressed">

        <Border.Background>
            <ImageBrush
                Source="avares://Griddle.App/Assets/griddle-industrial-red-tile.png"
                Stretch="UniformToFill"
                AlignmentX="Center"
                AlignmentY="Center"/>
        </Border.Background>

        <StackPanel
            Orientation="Horizontal"
            Spacing="8">

            <Button
                Classes="griddle-knob"
                Click="GriddleKnob_Click"
                Padding="0"
                Margin="0,-10,0,-10"
                Background="Transparent"
                BorderThickness="0">

                <Button.Template>
                    <ControlTemplate>
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            Background="Transparent"/>
                    </ControlTemplate>
                </Button.Template>

                <Grid
                    Width="82"
                    Height="108"
                    Margin="0,0,-8,0">

                    <Image
                        Source="avares://Griddle.App/Assets/griddle-toolbar-on.png"
                        Width="82"
                        Height="82"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsOverlayEngaged}"/>

                    <Image
                        Source="avares://Griddle.App/Assets/griddle-toolbar-off.png"
                        Width="82"
                        Height="82"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsOverlayDisengaged}"/>

                    <Image
                        Classes="recording-knob"
                        Source="avares://Griddle.App/Assets/griddle-toolbar-recording.png"
                        Width="82"
                        Height="82"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsRecording}"/>

                </Grid>

            </Button>

            <Border
                Width="1"
                Height="30"
                Background="#5A5A5A"
                Margin="2,0,2,0"/>

            <Button
                Classes="toolbar"
                Classes.active="{Binding IsRecording}"
                Click="RecordingButton_Click"
                ToolTip.Tip="Start / stop recording">

                <Grid Width="22" Height="22">

                    <Ellipse
                        Width="15"
                        Height="15"
                        Stroke="White"
                        StrokeThickness="2"
                        IsVisible="{Binding !IsRecording}"/>

                    <Ellipse
                        Width="7"
                        Height="7"
                        Fill="#E53935"
                        IsVisible="{Binding !IsRecording}"/>

                    <Rectangle
                        Width="10"
                        Height="10"
                        Fill="#E53935"
                        RadiusX="2"
                        RadiusY="2"
                        IsVisible="{Binding IsRecording}"/>

                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                ToolTip.Tip="Recording settings">

                <Grid Width="22" Height="22">

                    <Ellipse
                        Width="15"
                        Height="15"
                        Stroke="White"
                        StrokeThickness="2"/>

                    <Ellipse
                        Width="7"
                        Height="7"
                        Fill="#E53935"/>

                </Grid>

                <Button.Flyout>
                    <Flyout Placement="Bottom">

                        <Border
                            Background="#1B1D1F"
                            BorderBrush="#73787D"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">

                            <StackPanel
                                Spacing="8"
                                MinWidth="150">

                                <TextBlock
                                    Text="Recording"
                                    Foreground="White"
                                    FontWeight="Bold"/>

                                <CheckBox
                                    Classes="recording-option"
                                    Content="System Audio"
                                    IsChecked="{Binding IsSystemAudioEnabled, Mode=TwoWay}"/>

                                <CheckBox
                                    Classes="recording-option"
                                    Content="Include Griddle"
                                    IsChecked="{Binding IncludeGriddleInRecording, Mode=TwoWay}"/>

                                <CheckBox
                                    Classes="recording-option"
                                    Content="Microphone"
                                    IsChecked="{Binding IsMicrophoneEnabled, Mode=TwoWay}"/>

                                <ComboBox
                                    ItemsSource="{Binding MicrophoneDevices}"
                                    SelectedItem="{Binding SelectedMicrophoneDevice, Mode=TwoWay}"
                                    IsEnabled="{Binding IsMicrophoneEnabled}"
                                    MinWidth="180"
                                    ToolTip.Tip="Microphone input"/>

                            </StackPanel>

                        </Border>

                    </Flyout>
                </Button.Flyout>

            </Button>

            <Button
                Classes="toolbar"
                Classes.active="{Binding IsSelectionSelected}"
                Click="SelectionButton_Click"
                ToolTip.Tip="Select">

                <Grid Width="22" Height="22">
                    <Path
                        Stroke="White"
                        StrokeThickness="2"
                        Data="M4,3 L17,12 L11,13 L14,19 L11,20 L8,14 L4,18 Z"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                Classes.active="{Binding IsPenSelected}"
                Click="PenButton_Click"
                ToolTip.Tip="Pen">

                <Grid Width="22" Height="22">
                    <Line
                        StartPoint="5,17"
                        EndPoint="16,6"
                        Stroke="White"
                        StrokeThickness="3"
                        StrokeLineCap="Round"/>

                    <Ellipse
                        Width="5"
                        Height="5"
                        Fill="White"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,2,2,0"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                Classes.active="{Binding IsHighlighterSelected}"
                Click="HighlighterButton_Click"
                ToolTip.Tip="Highlighter">

                <Grid Width="22" Height="22">
                    <Rectangle
                        Width="8"
                        Height="16"
                        Fill="#FFF3C400"
                        RadiusX="2"
                        RadiusY="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">

                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="-35"/>
                        </Rectangle.RenderTransform>

                    </Rectangle>

                    <Rectangle
                        Width="14"
                        Height="3"
                        Fill="#FFF3C400"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,1"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                Classes.active="{Binding IsArrowSelected}"
                Click="ArrowButton_Click"
                ToolTip.Tip="Arrow">

                <Grid Width="22" Height="22">
                    <Line
                        StartPoint="4,18"
                        EndPoint="17,5"
                        Stroke="White"
                        StrokeThickness="3"
                        StrokeLineCap="Round"/>

                    <Line
                        StartPoint="11,5"
                        EndPoint="17,5"
                        Stroke="White"
                        StrokeThickness="3"
                        StrokeLineCap="Round"/>

                    <Line
                        StartPoint="17,5"
                        EndPoint="17,11"
                        Stroke="White"
                        StrokeThickness="3"
                        StrokeLineCap="Round"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                Classes.active="{Binding IsRectangleSelected}"
                Click="RectangleButton_Click"
                ToolTip.Tip="Rectangle">

                <Grid Width="22" Height="22">
                    <Rectangle
                        Width="14"
                        Height="12"
                        Stroke="White"
                        StrokeThickness="2"
                        Fill="Transparent"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                Classes.active="{Binding IsTextSelected}"
                Click="TextButton_Click"
                ToolTip.Tip="Text">

                <Grid Width="22" Height="22">
                    <TextBlock
                        Text="T"
                        Foreground="White"
                        FontSize="18"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                Classes.active="{Binding IsCalloutSelected}"
                Click="CalloutButton_Click"
                ToolTip.Tip="Callout">

                <Grid Width="22" Height="22">
                    <Ellipse
                        Width="16"
                        Height="16"
                        Stroke="White"
                        StrokeThickness="2"/>

                    <TextBlock
                        Text="1"
                        Foreground="White"
                        FontSize="10"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                Click="FlipCalloutLabelButton_Click"
                ToolTip.Tip="Move callout label to opposite end">

                <Grid Width="22" Height="22">

                    <Line
                        StartPoint="4,11"
                        EndPoint="18,11"
                        Stroke="White"
                        StrokeThickness="2"/>

                    <Ellipse
                        Width="8"
                        Height="8"
                        Stroke="White"
                        StrokeThickness="1.5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        Text="T"
                        Foreground="White"
                        FontSize="9"
                        FontWeight="Bold"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>

                </Grid>

            </Button>

            <Border
                Width="1"
                Height="30"
                Background="#5A5A5A"
                Margin="2,0,2,0"/>

            <Button
                Classes="toolbar"
                ToolTip.Tip="Annotation color">

                <Grid Width="22" Height="22">

                    <Ellipse
                        Width="16"
                        Height="16"
                        Fill="{Binding SelectedColorBrush}"
                        Stroke="White"
                        StrokeThickness="1"/>

                </Grid>

                <Button.Flyout>
                    <Flyout Placement="Bottom">

                        <Border
                            Background="#1B1D1F"
                            BorderBrush="#73787D"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8">

                            <Grid
                                ColumnDefinitions="Auto,Auto,Auto,Auto"
                                RowDefinitions="Auto,Auto"
                                ColumnSpacing="6"
                                RowSpacing="6">

                                <Button
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Classes="color-swatch"
                                    Classes.active="{Binding IsRedSelected}"
                                    Click="RedColorButton_Click"
                                    ToolTip.Tip="Red">
                                    <Ellipse Fill="Red"/>
                                </Button>

                                <Button
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Classes="color-swatch"
                                    Classes.active="{Binding IsOrangeSelected}"
                                    Click="OrangeColorButton_Click"
                                    ToolTip.Tip="Orange">
                                    <Ellipse Fill="Orange"/>
                                </Button>

                                <Button
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Classes="color-swatch"
                                    Classes.active="{Binding IsYellowSelected}"
                                    Click="YellowColorButton_Click"
                                    ToolTip.Tip="Yellow">
                                    <Ellipse Fill="Yellow"/>
                                </Button>

                                <Button
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    Classes="color-swatch"
                                    Classes.active="{Binding IsGreenSelected}"
                                    Click="GreenColorButton_Click"
                                    ToolTip.Tip="Green">
                                    <Ellipse Fill="LimeGreen"/>
                                </Button>

                                <Button
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Classes="color-swatch"
                                    Classes.active="{Binding IsBlueSelected}"
                                    Click="BlueColorButton_Click"
                                    ToolTip.Tip="Blue">
                                    <Ellipse Fill="DodgerBlue"/>
                                </Button>

                                <Button
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Classes="color-swatch"
                                    Classes.active="{Binding IsPurpleSelected}"
                                    Click="PurpleColorButton_Click"
                                    ToolTip.Tip="Purple">
                                    <Ellipse Fill="MediumPurple"/>
                                </Button>

                                <Button
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Classes="color-swatch"
                                    Classes.active="{Binding IsWhiteSelected}"
                                    Click="WhiteColorButton_Click"
                                    ToolTip.Tip="White">
                                    <Ellipse
                                        Fill="White"
                                        Stroke="#777777"
                                        StrokeThickness="1"/>
                                </Button>

                                <Button
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    Classes="color-swatch"
                                    Classes.active="{Binding IsBlackSelected}"
                                    Click="BlackColorButton_Click"
                                    ToolTip.Tip="Black">
                                    <Ellipse
                                        Fill="Black"
                                        Stroke="White"
                                        StrokeThickness="1"/>
                                </Button>

                            </Grid>

                        </Border>

                    </Flyout>
                </Button.Flyout>

            </Button>

            

            <Button
                Classes="toolbar"
                ToolTip.Tip="Thickness">

                <Grid Width="22" Height="22">
                    <Line
                        StartPoint="3,7"
                        EndPoint="19,7"
                        Stroke="White"
                        StrokeThickness="2"
                        StrokeLineCap="Round"/>

                    <Line
                        StartPoint="3,15"
                        EndPoint="19,15"
                        Stroke="White"
                        StrokeThickness="5"
                        StrokeLineCap="Round"/>
                </Grid>

                <Button.Flyout>
                    <Flyout Placement="Bottom">

                        <Border
                            Background="#1B1D1F"
                            BorderBrush="#73787D"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8">

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="6">

                                <Button
                                    Classes="thickness-swatch"
                                    Click="Thickness2Button_Click"
                                    ToolTip.Tip="2 px">
                                    <Line
                                        StartPoint="4,15"
                                        EndPoint="26,15"
                                        Stroke="White"
                                        StrokeThickness="2"
                                        StrokeLineCap="Round"/>
                                </Button>

                                <Button
                                    Classes="thickness-swatch"
                                    Click="Thickness4Button_Click"
                                    ToolTip.Tip="4 px">
                                    <Line
                                        StartPoint="4,15"
                                        EndPoint="26,15"
                                        Stroke="White"
                                        StrokeThickness="4"
                                        StrokeLineCap="Round"/>
                                </Button>

                                <Button
                                    Classes="thickness-swatch"
                                    Click="Thickness6Button_Click"
                                    ToolTip.Tip="6 px">
                                    <Line
                                        StartPoint="4,15"
                                        EndPoint="26,15"
                                        Stroke="White"
                                        StrokeThickness="6"
                                        StrokeLineCap="Round"/>
                                </Button>

                                <Button
                                    Classes="thickness-swatch"
                                    Click="Thickness8Button_Click"
                                    ToolTip.Tip="8 px">
                                    <Line
                                        StartPoint="4,15"
                                        EndPoint="26,15"
                                        Stroke="White"
                                        StrokeThickness="8"
                                        StrokeLineCap="Round"/>
                                </Button>

                            </StackPanel>

                        </Border>

                    </Flyout>
                </Button.Flyout>

            </Button>

            <Border
                Width="1"
                Height="30"
                Background="#5A5A5A"
                Margin="2,0,2,0"/>

            <Button
                Classes="toolbar"
                Click="NewCalloutGroupButton_Click"
                ToolTip.Tip="Start new callout sequence">

                <Grid Width="22" Height="22">
                    <Ellipse
                        Width="16"
                        Height="16"
                        Stroke="White"
                        StrokeThickness="2"/>

                    <TextBlock
                        Text="1↺"
                        Foreground="White"
                        FontSize="8"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                Click="ContinueCalloutGroupButton_Click"
                ToolTip.Tip="Continue selected callout sequence">

                <Grid Width="22" Height="22">
                    <Ellipse
                        Width="16"
                        Height="16"
                        Stroke="White"
                        StrokeThickness="2"/>

                    <TextBlock
                        Text="↺"
                        Foreground="White"
                        FontSize="12"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                Click="SelectCalloutGroupButton_Click"
                ToolTip.Tip="Select callout sequence">

                <Grid Width="22" Height="22">
                    <Ellipse
                        Width="14"
                        Height="14"
                        Stroke="White"
                        StrokeThickness="1.5"
                        HorizontalAlignment="Left"/>

                    <Ellipse
                        Width="14"
                        Height="14"
                        Stroke="White"
                        StrokeThickness="1.5"
                        HorizontalAlignment="Right"/>

                    <TextBlock
                        Text="•••"
                        Foreground="White"
                        FontSize="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                Click="HideCalloutGroupButton_Click"
                ToolTip.Tip="Hide selected callout sequence">

                <Grid Width="22" Height="22">
                    <TextBlock
                        Text="◉"
                        Foreground="White"
                        FontSize="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    <Line
                        StartPoint="4,18"
                        EndPoint="18,4"
                        Stroke="White"
                        StrokeThickness="2"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                Click="ShowLastHiddenCalloutGroupButton_Click"
                ToolTip.Tip="Show last hidden callout sequence">

                <Grid Width="22" Height="22">
                    <TextBlock
                        Text="◉"
                        Foreground="White"
                        FontSize="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                Classes.active="{Binding IsCalloutPresentationActive}"
                Click="StartCalloutPresentationButton_Click"
                ToolTip.Tip="Present selected callout sequence">

                <Grid Width="22" Height="22">

                    <Path
                        Fill="White"
                        Data="M7,4 L18,11 L7,18 Z"/>

                </Grid>

            </Button>

            <Border
                IsVisible="{Binding IsCalloutPresentationActive}"
                Height="40"
                MinWidth="52"
                Padding="8,0"
                CornerRadius="8"
                Background="#333333"
                BorderBrush="#F28C28"
                BorderThickness="1">

                <TextBlock
                    Text="{Binding PresentationProgressText}"
                    Foreground="White"
                    FontSize="13"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

            </Border>

            

            <Button
                Classes="toolbar"
                Click="RenumberCalloutGroupButton_Click"
                ToolTip.Tip="Compact selected callout sequence">

                <Grid Width="22" Height="22">
                    <TextBlock
                        Text="123"
                        Foreground="White"
                        FontSize="9"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Grid>

            </Button>

            <Border
                Width="1"
                Height="30"
                Background="#5A5A5A"
                Margin="2,0,2,0"/>

            <Button
                Classes="toolbar"
                Classes.active="{Binding IsTintEnabled}"
                Click="TintButton_Click"
                ToolTip.Tip="Toggle overlay tint">

                <Grid Width="22" Height="22">

                    <Border
                        Width="16"
                        Height="13"
                        BorderBrush="White"
                        BorderThickness="2"
                        Background="Transparent"
                        CornerRadius="2"/>

                    <Rectangle
                        Width="8"
                        Height="9"
                        Fill="#66FF8C00"
                        HorizontalAlignment="Left"
                        Margin="4,0,0,0"/>

                </Grid>

            </Button>

            <Button
                Classes="toolbar"
                ToolTip.Tip="Move overlay to display">

                <Grid Width="22" Height="22">

                    <Border
                        Width="17"
                        Height="12"
                        BorderBrush="White"
                        BorderThickness="2"
                        CornerRadius="2"
                        VerticalAlignment="Top"
                        Margin="0,2,0,0"/>

                    <Line
                        StartPoint="11,14"
                        EndPoint="11,18"
                        Stroke="White"
                        StrokeThickness="2"/>

                    <Line
                        StartPoint="7,18"
                        EndPoint="15,18"
                        Stroke="White"
                        StrokeThickness="2"
                        StrokeLineCap="Round"/>

                </Grid>

                <Button.Flyout>
                    <Flyout Placement="Bottom">

                        <Border
                            Background="#1B1D1F"
                            BorderBrush="#73787D"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8">

                            <StackPanel Spacing="4">

                                <TextBlock
                                    Text="Move Canvas"
                                    Foreground="#AAAAAA"
                                    FontSize="11"
                                    Margin="4,2,4,4"/>

                                <ItemsControl
                                    ItemsSource="{Binding Displays}">

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate
                                            x:DataType="vm:DisplayOption">

                                            <Button
                                                Classes="display-option"
                                                Click="DisplayOptionButton_Click"
                                                HorizontalContentAlignment="Left">

                                                <Grid
                                                    ColumnDefinitions="22,*"
                                                    Width="120">

                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Text="✓"
                                                        Foreground="#F28C28"
                                                        FontWeight="Bold"
                                                        IsVisible="{Binding IsActive}"/>

                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{Binding Name}"/>

                                                </Grid>

                                            </Button>

                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </StackPanel>

                        </Border>

                    </Flyout>
                </Button.Flyout>

            </Button>

            <Border
                Width="1"
                Height="30"
                Background="#5A5A5A"
                Margin="2,0,2,0"/>

            <Border
                MinWidth="110"
                MaxWidth="180"
                Height="32"
                Background="#17191B"
                BorderBrush="#73787D"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,0">

                <TextBlock
                    Text="{Binding SessionName}"
                    Foreground="#D7D7D7"
                    FontSize="11"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    ToolTip.Tip="{Binding SessionName}"/>

            </Border>

        </StackPanel>

    </Border>

</Window>
