<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Griddle.App.Views.UnsavedChangesDialog"
    Title="Unsaved Changes"
    Width="500"
    Height="230"
    CanResize="False"
    Topmost="True"
    ShowActivated="True"
    WindowStartupLocation="CenterOwner"
    Background="#121416">

    <Window.Styles>

        <Style Selector="Button.dialog-secondary">
            <Setter Property="Background" Value="#25282B"/>
            <Setter Property="Foreground" Value="#D7D7D7"/>
            <Setter Property="BorderBrush" Value="#50555A"/>
        </Style>

        <Style Selector="Button.dialog-secondary:pointerover">
            <Setter Property="Background" Value="#34383C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#73787D"/>
        </Style>

        <Style Selector="Button.dialog-secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1C1F21"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#F28C28"/>
        </Style>

        <Style Selector="Button.dialog-primary">
            <Setter Property="Background" Value="#F28C28"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#FFAD55"/>
        </Style>

        <Style Selector="Button.dialog-primary:pointerover">
            <Setter Property="Background" Value="#FFA13D"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#FFC078"/>
        </Style>

        <Style Selector="Button.dialog-primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D97819"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#F28C28"/>
        </Style>

    </Window.Styles>

    <Border
        Margin="1"
        Padding="22,18"
        Background="#17191B"
        BorderBrush="#73787D"
        BorderThickness="1"
        CornerRadius="8">

        <Grid
            RowDefinitions="Auto,Auto,Auto,*,Auto">

            <StackPanel
                Grid.Row="0"
                Orientation="Horizontal"
                Spacing="7">

                <TextBlock
                    Text="⚠"
                    Foreground="#F28C28"
                    FontSize="15"
                    VerticalAlignment="Center"/>

                <TextBlock
                    Text="UNSAVED CHANGES"
                    Foreground="#F28C28"
                    FontSize="11"
                    FontWeight="Bold"
                    LetterSpacing="1.5"
                    VerticalAlignment="Center"/>

            </StackPanel>

            <TextBlock
                Grid.Row="1"
                Text="&quot;You done with that, Chef?&quot;"
                Foreground="White"
                FontSize="24"
                FontWeight="Normal"
                FontStyle="Italic"
                FontFamily="Arial"
                Margin="0,7,0,0"/>

            <TextBlock
                Grid.Row="2"
                Text="The current Griddle session has unsaved changes."
                Foreground="#C3C7CB"
                FontSize="16"
                TextWrapping="Wrap"
                Margin="0,10,0,0"/>

            <TextBlock
                Grid.Row="3"
                Text="Would you like to save them before continuing?"
                Foreground="#A8ADB2"
                FontSize="14"
                Margin="0,8,0,0"
                VerticalAlignment="Top"/>

            <StackPanel
                Grid.Row="4"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="10"
                Margin="0,16,0,0">

                <Button
                    Classes="dialog-secondary"
                    Content="Cancel"
                    Click="CancelButton_Click"
                    MinWidth="88"
                    Height="36"
                    Padding="16,0"
                    BorderThickness="1"
                    CornerRadius="6"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>

                <Button
                    Classes="dialog-secondary"
                    Content="Don't Save"
                    Click="DontSaveButton_Click"
                    MinWidth="110"
                    Height="36"
                    Padding="16,0"
                    BorderThickness="1"
                    CornerRadius="6"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>

                <Button
                    Classes="dialog-primary"
                    Content="Save"
                    Click="SaveButton_Click"
                    MinWidth="90"
                    Height="36"
                    Padding="18,0"
                    BorderThickness="1"
                    CornerRadius="6"
                    FontWeight="Bold"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>