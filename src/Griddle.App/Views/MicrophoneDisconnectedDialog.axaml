<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Griddle.App.Views.MicrophoneDisconnectedDialog"
    Title="Microphone Disconnected"
    Width="540"
    Height="285"
    CanResize="False"
    Topmost="True"
    ShowActivated="True"
    WindowStartupLocation="CenterOwner"
    Background="#121416">

    <Window.Styles>

        <Style Selector="Button.dialog-secondary">
            <Setter Property="Background" Value="#25282B"/>
            <Setter Property="Foreground" Value="#D7D7D7"/>
            <Setter Property="BorderBrush" Value="#50555A"/>

            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">

                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>

                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.dialog-secondary:pointerover">
            <Setter Property="Background" Value="#3B3F43"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#8B9196"/>
        </Style>

        <Style Selector="Button.dialog-secondary:pressed">
            <Setter Property="Background" Value="#1C1F21"/>
            <Setter Property="BorderBrush" Value="#F28C28"/>
        </Style>

        <Style Selector="Button.dialog-primary">
            <Setter Property="Background" Value="#F28C28"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#FFAD55"/>

            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">

                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>

                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.dialog-primary:pointerover">
            <Setter Property="Background" Value="#FFA546"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#FFD09A"/>
        </Style>

        <Style Selector="Button.dialog-primary:pressed">
            <Setter Property="Background" Value="#D97819"/>
            <Setter Property="BorderBrush" Value="#F28C28"/>
        </Style>

    </Window.Styles>

    <Border
        Margin="1"
        Padding="22,18"
        Background="#17191B"
        BorderBrush="#73787D"
        BorderThickness="1"
        CornerRadius="8">

        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

            <StackPanel
                Grid.Row="0"
                Orientation="Horizontal"
                Spacing="7">

                <TextBlock
                    Text="⚠"
                    Foreground="#F28C28"
                    FontSize="15"
                    VerticalAlignment="Center"/>

                <TextBlock
                    Text="MICROPHONE DISCONNECTED"
                    Foreground="#F28C28"
                    FontSize="11"
                    FontWeight="Bold"
                    LetterSpacing="1.5"
                    VerticalAlignment="Center"/>

            </StackPanel>

            <TextBlock
                Grid.Row="1"
                Text="&quot;Your mic lost its fire.&quot;"
                Foreground="White"
                FontSize="24"
                FontWeight="Normal"
                FontStyle="Italic"
                FontFamily="Arial"
                Margin="0,7,0,0"/>

            <TextBlock
                Grid.Row="2"
                Text="Griddle lost your microphone during recording. The recording is still running, but microphone audio is no longer being captured."
                Foreground="#C3C7CB"
                FontSize="16"
                TextWrapping="Wrap"
                Margin="0,10,0,0"/>

            <TextBlock
                Grid.Row="3"
                Text="Reconnect your microphone and start a new recording to restore microphone audio."
                Foreground="#A8ADB2"
                FontSize="14"
                TextWrapping="Wrap"
                Margin="0,8,0,0"/>

            <StackPanel
                Grid.Row="5"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="10"
                Margin="0,16,0,0">

                <Button
                    Classes="dialog-secondary"
                    Content="Continue Without Mic"
                    Click="ContinueButton_Click"
                    MinWidth="175"
                    Height="36"
                    Padding="16,0"
                    BorderThickness="1"
                    CornerRadius="6"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>

                <Button
                    Classes="dialog-primary"
                    Content="Stop Recording"
                    Click="StopButton_Click"
                    MinWidth="135"
                    Height="36"
                    Padding="18,0"
                    BorderThickness="1"
                    CornerRadius="6"
                    FontWeight="Bold"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>