<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Griddle.App.Views.MicrophoneDisconnectedDialog"
    Title="Microphone Disconnected"
    Width="520"
    Height="220"
    CanResize="False"
    WindowStartupLocation="CenterOwner">

    <StackPanel
        Margin="24"
        Spacing="16">

        <TextBlock
            Text="Your Mic Lost Its Fire"
            FontSize="20"
            FontWeight="Bold"/>

        <TextBlock
            Text="Griddle lost your microphone during recording. The recording is still running, but microphone audio is no longer being captured."
            TextWrapping="Wrap"/>

        <TextBlock
            Text="Reconnect your microphone and start a new recording to restore microphone audio."
            TextWrapping="Wrap"/>

        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="12">

            <Button
                Content="Continue Without Mic"
                Click="ContinueButton_Click"/>

            <Button
                Content="Stop Recording"
                Click="StopButton_Click"/>

        </StackPanel>

    </StackPanel>
</Window>