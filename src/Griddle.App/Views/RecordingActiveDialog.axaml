<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Griddle.App.Views.RecordingActiveDialog"
    Title="Recording in Progress"
    Width="500"
    Height="230"
    CanResize="False"
    Topmost="True"
    ShowActivated="True"
    WindowStartupLocation="CenterOwner"
    Background="#121416">

    <Window.Styles>

        <Style Selector="Button.dialog-primary">
            <Setter Property="Background" Value="#F28C28"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#FFAD55"/>

            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">

                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>

                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.dialog-primary:pointerover">
            <Setter Property="Background" Value="#FFA546"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#FFD09A"/>
        </Style>

        <Style Selector="Button.dialog-primary:pressed">
            <Setter Property="Background" Value="#D97819"/>
            <Setter Property="BorderBrush" Value="#F28C28"/>
        </Style>

    </Window.Styles>

    <Border
        Margin="1"
        Padding="22,18"
        Background="#17191B"
        BorderBrush="#73787D"
        BorderThickness="1"
        CornerRadius="8">

        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

            <StackPanel
                Grid.Row="0"
                Orientation="Horizontal"
                Spacing="7">

                <Ellipse
                    Width="9"
                    Height="9"
                    Fill="#E53935"
                    VerticalAlignment="Center"/>

                <TextBlock
                    Text="RECORDING ACTIVE"
                    Foreground="#F28C28"
                    FontSize="11"
                    FontWeight="Bold"
                    LetterSpacing="1.5"
                    VerticalAlignment="Center"/>

            </StackPanel>

            <TextBlock
                Grid.Row="1"
                Text="&quot;Still cooking, Chef.&quot;"
                Foreground="White"
                FontSize="24"
                FontWeight="Normal"
                FontStyle="Italic"
                FontFamily="Arial"
                Margin="0,7,0,0"/>

            <TextBlock
                Grid.Row="2"
                Text="A recording is currently in progress."
                Foreground="#C3C7CB"
                FontSize="16"
                TextWrapping="Wrap"
                Margin="0,10,0,0"/>

            <TextBlock
                Grid.Row="3"
                Text="Stop the recording before closing Griddle or changing sessions."
                Foreground="#A8ADB2"
                FontSize="14"
                TextWrapping="Wrap"
                Margin="0,8,0,0"
                VerticalAlignment="Top"/>

            <Button
                Grid.Row="4"
                Classes="dialog-primary"
                Content="Got It"
                Click="OkButton_Click"
                MinWidth="90"
                Height="36"
                Padding="18,0"
                BorderThickness="1"
                CornerRadius="6"
                FontWeight="Bold"
                HorizontalAlignment="Right"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Margin="0,16,0,0"/>

        </Grid>

    </Border>

</Window>