<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Griddle.App.Views.RecoveryDialog"
    Title="Griddle Recovery"
    Width="620"
    Height="245"
    CanResize="False"
    Topmost="True"
    ShowActivated="True"
    WindowStartupLocation="CenterOwner"
    Background="#121416">

    <Border
        Margin="1"
        Padding="22,18"
        Background="#17191B"
        BorderBrush="#73787D"
        BorderThickness="1"
        CornerRadius="8">

        <Grid
            ColumnDefinitions="*,190"
            RowDefinitions="Auto,Auto,Auto,*,Auto"
            ColumnSpacing="18">

            <!-- AUTO RECOVERY -->

            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="7">

                <TextBlock
                    Text="⚠"
                    Foreground="#F28C28"
                    FontSize="15"
                    VerticalAlignment="Center"/>

                <TextBlock
                    Text="AUTO RECOVERY"
                    Foreground="#F28C28"
                    FontSize="11"
                    FontWeight="Bold"
                    LetterSpacing="1.5"
                    VerticalAlignment="Center"/>

            </StackPanel>

            <!-- HEADLINE -->

            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Text="...is something burning?"
                Foreground="White"
                FontSize="22"
                FontWeight="Bold"
                Margin="0,7,0,0"/>

            <!-- BODY -->

            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                Text="Griddle found unsaved work from a previous session."
                Foreground="#C3C7CB"
                FontSize="16"
                TextWrapping="Wrap"
                Margin="0,10,0,0"/>

            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                Text="Would you like to restore it?"
                Foreground="#A8ADB2"
                FontSize="14"
                Margin="0,8,0,0"
                VerticalAlignment="Top"/>

            <!-- RECOVERY GRIDDLE -->

            <Image
                Grid.Row="0"
                Grid.RowSpan="4"
                Grid.Column="1"
                Source="avares://Griddle.App/Assets/griddle-recovery.png"
                Width="190"
                Height="165"
                Stretch="Uniform"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"/>

            <!-- BUTTONS -->

            <StackPanel
                Grid.Row="4"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="10"
                Margin="0,16,0,0">

                <Button
                    Content="Discard"
                    Click="DiscardButton_Click"
                    MinWidth="96"
                    Height="36"
                    Padding="16,0"
                    Background="#25282B"
                    Foreground="#D7D7D7"
                    BorderBrush="#50555A"
                    BorderThickness="1"
                    CornerRadius="6"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>

                <Button
                    Content="Restore Session"
                    Click="RestoreButton_Click"
                    MinWidth="145"
                    Height="36"
                    Padding="18,0"
                    Background="#F28C28"
                    Foreground="#111111"
                    BorderBrush="#FFAD55"
                    BorderThickness="1"
                    CornerRadius="6"
                    FontWeight="Bold"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>